<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mr. Sosial Media Finance</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex flex-col justify-between">

    <div id="app" class="max-w-md mx-auto w-full p-4 flex-1 flex flex-col justify-center">
        
        <div id="login-view" class="bg-slate-800 p-6 rounded-2xl shadow-xl border border-slate-700">
            <div class="text-center mb-6">
                <h1 class="text-2xl font-bold text-amber-400">Mr. Sosial Media Finance</h1>
                <p class="text-xs text-slate-400 mt-1">Strategi | Pertumbuhan | Keamanan</p>
            </div>
            <form id="login-form" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Username</label>
                    <input type="text" id="username" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-amber-400">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-slate-400 mb-1">Password</label>
                    <input type="password" id="password" required class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-amber-400">
                </div>
                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2.5 rounded-lg transition duration-200">Masuk</button>
            </form>
        </div>

        <div id="dashboard-view" class="hidden space-y-4">
            <div class="flex justify-between items-center bg-slate-800 p-4 rounded-xl border border-slate-700">
                <div>
                    <h2 class="font-bold text-lg text-amber-400">Halo, Boss!</h2>
                    <p class="text-xs text-slate-400">Penyimpanan Lokal (HP)</p>
                </div>
                <button onclick="logout()" class="bg-red-500/20 hover:bg-red-500/30 text-red-400 text-xs px-3 py-1.5 rounded-lg border border-red-500/30 transition">Keluar</button>
            </div>

            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 space-y-3">
                <h3 class="text-sm font-semibold text-slate-300">Tambah Catatan Keuangan</h3>
                <div class="space-y-2">
                    <div class="flex gap-2">
                        <button type="button" id="btn-in" onclick="setType('in')" class="flex-1 py-1.5 text-xs font-bold rounded-lg border border-emerald-500 bg-emerald-500/20 text-emerald-400 transition">Pemasukan</button>
                        <button type="button" id="btn-out" onclick="setType('out')" class="flex-1 py-1.5 text-xs font-bold rounded-lg border border-slate-700 bg-slate-900 text-slate-400 transition">Pengeluaran</button>
                    </div>

                    <input type="text" id="tx-desc" placeholder="Deskripsi (Cth: Omset / Biaya Server)" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm">
                    <input type="number" id="tx-amount" placeholder="Nominal (Rp)" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm">
                    
                    <button onclick="addTransaction()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2 rounded-lg text-sm transition">Simpan Transaksi</button>
                </div>
            </div>

            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 space-y-2">
                <div class="flex justify-between items-center">
                    <h3 class="text-sm font-semibold text-slate-300">Riwayat Rekap</h3>
                    <button onclick="clearData()" class="text-[10px] text-red-400 hover:underline">Hapus Semua</button>
                </div>
                <div id="tx-list" class="space-y-1.5 max-h-40 overflow-y-auto text-xs text-slate-300">
                    <p class="text-slate-500 italic">Belum ada transaksi.</p>
                </div>
            </div>
        </div>

    </div>

    <footer class="text-center py-4 text-xs text-slate-500">
        Mr. Sosial Media Finance &copy; 2026
    </footer>

    <script>
        const CORRECT_USER = "admin";
        const CORRECT_PASS = "12345";
        let currentType = 'in';

        function setType(type) {
            currentType = type;
            const btnIn = document.getElementById('btn-in');
            const btnOut = document.getElementById('btn-out');

            if(type === 'in') {
                btnIn.className = "flex-1 py-1.5 text-xs font-bold rounded-lg border border-emerald-500 bg-emerald-500/20 text-emerald-400 transition";
                btnOut.className = "flex-1 py-1.5 text-xs font-bold rounded-lg border border-slate-700 bg-slate-900 text-slate-400 transition";
            } else {
                btnOut.className = "flex-1 py-1.5 text-xs font-bold rounded-lg border border-red-500 bg-red-500/20 text-red-400 transition";
                btnIn.className = "flex-1 py-1.5 text-xs font-bold rounded-lg border border-slate-700 bg-slate-900 text-slate-400 transition";
            }
        }

        document.getElementById('login-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const u = document.getElementById('username').value;
            const p = document.getElementById('password').value;

            if(u === CORRECT_USER && p === CORRECT_PASS) {
                localStorage.setItem('isLoggedIn', 'true');
                showDashboard();
            } else {
                alert('Username atau Password salah!');
            }
        });

        function showDashboard() {
            document.getElementById('login-view').classList.add('hidden');
            document.getElementById('dashboard-view').classList.remove('hidden');
            loadTransactions();
        }

        function logout() {
            localStorage.removeItem('isLoggedIn');
            document.getElementById('dashboard-view').classList.add('hidden');
            document.getElementById('login-view').classList.remove('hidden');
        }

        function addTransaction() {
            const desc = document.getElementById('tx-desc').value;
            const amount = document.getElementById('tx-amount').value;

            if(!desc || !amount) {
                alert('Mohon isi deskripsi dan nominal!');
                return;
            }

            const months = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            const now = new Date();
            
            const newTx = {
                month: months[now.getMonth()],
                date: now.getDate(),
                desc: desc,
                amount: Number(amount),
                type: currentType
            };

            let transactions = JSON.parse(localStorage.getItem('mrsosial_tx') || '[]');
            transactions.push(newTx);
            localStorage.setItem('mrsosial_tx', JSON.stringify(transactions));

            document.getElementById('tx-desc').value = '';
            document.getElementById('tx-amount').value = '';
            loadTransactions();
        }

        function loadTransactions() {
            let transactions = JSON.parse(localStorage.getItem('mrsosial_tx') || '[]');
            const listEl = document.getElementById('tx-list');
            
            if(transactions.length === 0) {
                listEl.innerHTML = '<p class="text-slate-500 italic">Belum ada transaksi.</p>';
                return;
            }

            listEl.innerHTML = '';
            transactions.reverse().forEach((tx) => {
                const color = tx.type === 'in' ? 'text-emerald-400' : 'text-red-400';
                const prefix = tx.type === 'in' ? '+ Rp ' : '- Rp ';
                listEl.innerHTML += `
                    <div class="flex justify-between items-center bg-slate-900 p-2 rounded border border-slate-700/50">
                        <div>
                            <span class="font-medium text-slate-200">${tx.desc}</span>
                            <span class="block text-[10px] text-slate-500">${tx.month}, Tgl ${tx.date}</span>
                        </div>
                        <span class="${color} font-semibold">${prefix}${tx.amount.toLocaleString('id-ID')}</span>
                    </div>
                `;
            });
        }

        function clearData() {
            if(confirm('Yakin ingin menghapus seluruh riwayat rekap di HP ini?')) {
                localStorage.removeItem('mrsosial_tx');
                loadTransactions();
            }
        }

        window.onload = function() {
            if(localStorage.getItem('isLoggedIn') === 'true') {
                showDashboard();
            }
        }
    </script>
</body>
</html>
